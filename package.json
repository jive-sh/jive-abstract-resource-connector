{
  "$schema": "./package.schema.json",
  "license": "MIT",
  "name": "jive-abstract-resource-connector",
  "description": "A Jive abstract for connectors: resources that link Jive to an outside system (npm, Slack, a database), each a Convex component. Extends jive-abstract-resource, whose machinery scaffolds, builds, audits and publishes them.",
  "version": "0.1.0",
  "type": "module",
  "peerDependencies": {
    "effect": "^4.0.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "jive-abstract-resource": "^0.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "effect": "^4.0.0",
    "jive-abstract-library": "0.2.1",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "jive:cicd:get-config": "jive-library cicd get-config",
    "jive:cicd:build": "jive-library cicd build",
    "jive:cicd:audit": "tsc --noEmit -p tsconfig.json && bun test",
    "jive:cicd:deploy:plan": "jive-library cicd deploy-plan",
    "jive:cicd:upload-artifacts": "jive-library cicd upload-artifacts",
    "jive:cicd:deploy": "jive-library cicd deploy",
    "dev": "jive-library dev"
  },
  "jive": {
    "cicd": {
      "deploy": {
        "verb": "Publish Tag",
        "branches": {
          "main": [
            "latest"
          ]
        },
        "previews": false,
        "sequentially": true
      },
      "runsOnPullRequests": true,
      "runsOn": "ubuntu-latest",
      "requiredSecrets": [
        "NPM_TOKEN"
      ]
    },
    "library": {
      "daemons": []
    }
  }
}
